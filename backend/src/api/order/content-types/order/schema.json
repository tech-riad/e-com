{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order",
    "description": "Customer checkout orders"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "customerName": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "text",
      "required": true
    },
    "city": {
      "type": "string"
    },
    "division": {
      "type": "string"
    },
    "paymentMethod": {
      "type": "enumeration",
      "enum": ["Cash on Delivery", "bKash", "Nagad", "Card"],
      "default": "Cash on Delivery"
    },
    "note": {
      "type": "text"
    },
    "items": {
      "type": "json"
    },
    "total": {
      "type": "decimal"
    },
    "eventId": {
      "type": "string",
      "private": true
    },
    "fbp": {
      "type": "string",
      "private": true
    },
    "fbc": {
      "type": "string",
      "private": true
    },
    "eventSourceUrl": {
      "type": "string",
      "private": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "confirmed", "shipped", "delivered", "cancelled"],
      "default": "pending"
    }
  }
}